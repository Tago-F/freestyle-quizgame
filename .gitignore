# .gitignore

### General ###
*.log
.DS_Store
Thumbs.db

### IDE ###
# IntelliJ
.idea/
*.iml
*.ipr
*.iws
out/

# VSCode
.vscode/

### Frontend - Angular (frontend/) ###
# Compiled output
frontend/dist/
frontend/tmp/
frontend/out-tsc/
frontend/bazel-out/

# Node modules
frontend/node_modules/

# Angular cache
frontend/.angular/cache/

# Log files
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*

# Test results
frontend/coverage/

### Backend - Spring Boot / Maven (backend/) ###
# Compiled output
backend/target/

# Maven wrapper local files
backend/.mvn/

# Log files
backend/*.log

# Maven backup files
backend/pom.xml.tag
backend/pom.xml.releaseBackup
backend/pom.xml.versionsBackup
backend/pom.xml.next
backend/release.properties
backend/dependency-reduced-pom.xml
backend/buildNumber.properties
